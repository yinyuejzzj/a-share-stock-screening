{Daily technical subset only. Fixed mode B, K=1, neutral market.}
{PROFILE: 1 strict, 2 standard, 3 relaxed. Decimal returns, no live volume ratio.}
PROFILE:=2;
RETLO:=IF(PROFILE=1,0.025,IF(PROFILE=2,0.02,0.01));
RETHI:=IF(PROFILE=1,0.06,IF(PROFILE=2,0.07,0.085));
DEVLIM:=IF(PROFILE=1,0.03,IF(PROFILE=2,0.05,0.08));
AMPMIN:=IF(PROFILE=1,0.03,IF(PROFILE=2,0.03,0.02));
RET1:=(C-REF(C,1))/REF(C,1);
DEV20:=(C-MA(C,20))/MA(C,20);
AMPL:=(H-L)/REF(C,1);
GENEOK:=IF(PROFILE=1,COUNT(RET1>=0.098,20)>0,IF(PROFILE=2,COUNT(RET1>=0.098,30)>0,COUNT(RET1>=0.098,45)>0));
MAOK:=(MA(C,5)>MA(C,10)) AND (MA(C,10)>MA(C,20));
VALIDP:=(PROFILE=1) OR (PROFILE=2) OR (PROFILE=3);
XG:VALIDP AND BARSCOUNT(C)>=60 AND VOL>0 AND REF(C,1)>0 AND RET1>=RETLO AND RET1<=RETHI AND DEV20>=-DEVLIM AND DEV20<=DEVLIM AND AMPL>=AMPMIN AND GENEOK AND MAOK;
