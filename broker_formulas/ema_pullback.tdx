{Daily conditional selection. PROFILE: 1 strict, 2 standard, 3 relaxed.}
PROFILE:=2;
TOUCH:=IF(PROFILE=1,0.01,IF(PROFILE=2,0.02,0.03));
SHRINK:=IF(PROFILE=1,0.65,IF(PROFILE=2,0.80,0.95));
E20:=EMA(C,20);
VMA5:=MA(VOL,5);
TRENDOK:=(E20>REF(E20,9)) OR (COUNT(C>E20,10)>=6);
VALIDP:=(PROFILE=1) OR (PROFILE=2) OR (PROFILE=3);
XG:VALIDP AND BARSCOUNT(C)>=25 AND VOL>0 AND VMA5>0 AND TRENDOK AND L<=E20*(1+TOUCH) AND C>E20 AND VOL<VMA5*SHRINK;
